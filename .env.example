# Copy to .env and fill in. Never commit the real .env.

# --- Django core ---
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=iadebayo.foundation,www.iadebayo.foundation
DJANGO_CSRF_TRUSTED_ORIGINS=https://iadebayo.foundation,https://www.iadebayo.foundation
SITE_BASE_URL=https://www.iadebayo.foundation

# --- Applicant video downloads ---
# Staff download application videos through /forms/applications/<id>/video/.
# Behind nginx with the `internal` /protected-media/ location configured
# (see DROPLET_DEPLOY.md), set this True so nginx does the transfer instead of
# a Gunicorn worker. Leave False on cPanel, locally, or anywhere else.
X_ACCEL_REDIRECT=False

# --- Database (cPanel > MySQL Databases) ---
DB_ENGINE=mysql
DB_NAME=youruser_iadebayo
DB_USER=youruser_django
DB_PASSWORD=
DB_HOST=localhost

# --- Email (SendGrid SMTP relay) ---
# EMAIL_BACKEND defaults to "console", which PRINTS mail instead of sending it.
# Leaving it unset on a server means no applicant ever hears back, silently.
#
# EMAIL_HOST_USER is the literal word "apikey" -- not your login, not an email
# address. That is SendGrid's convention for SMTP auth; the API key goes in the
# password field. Create the key with Mail Send permission at
# https://app.sendgrid.com/settings/api_keys
#
# Before any of this works, DEFAULT_FROM_EMAIL must be a verified sender:
# https://app.sendgrid.com/settings/sender_auth -- use Domain Authentication
# rather than Single Sender, since it also publishes the SPF/DKIM records that
# keep these messages out of spam. SendGrid will accept your login and *then*
# reject the From address if you skip this, which reads like a password problem
# but is not one. Verify with: python manage.py send_test_email
EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=IADEBAYO Foundation <noreply@iadebayo.foundation>
FOUNDATION_NOTIFY_EMAIL=hello@iadebayo.foundation

# Port 465 with SSL is used above because Django rejects a config with both
# EMAIL_USE_SSL and EMAIL_USE_TLS true. If you switch to 587 you must flip both
# flags together -- EMAIL_USE_SSL=False and EMAIL_USE_TLS=True -- or startup
# fails with a ValueError.
#
# Alternative: your own mail host instead of SendGrid (e.g. cPanel, Namecheap
# Private Email). Same variables, different values, no code change:
#   EMAIL_HOST=mail.iadebayo.foundation
#   EMAIL_HOST_USER=noreply@iadebayo.foundation
#   EMAIL_HOST_PASSWORD=the-mailbox-password

# --- reCAPTCHA v2 checkbox (https://www.google.com/recaptcha/admin) ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Google Analytics 4 (create property at analytics.google.com) ---
GA_MEASUREMENT_ID=

# --- Meta (Facebook) Pixel ---
# The numeric pixel id from Events Manager > Data sources. Set it on the live
# site only: fill it in locally and your own clicking around is counted as real
# ad conversions. Leave it empty and no Facebook code is served at all.
#
# The base code and the conversion events are already in the templates -- there
# is nothing to paste from Meta's setup email but this number. Events fired:
#   SubmitApplication  a completed Embark application
#   Lead               faculty, volunteer, partnership forms
#   Contact            the contact form
#   Subscribe          newsletter sign-up
# After deploying, check Events Manager > Data sources; the status turns Active
# within about 20 minutes of the first real visit.
META_PIXEL_ID=

# --- Embark: 1-minute programme explainer on YouTube (shown above the
#     application form). Leave blank until the clip is published. ---
EMBARK_INTRO_VIDEO_URL=
